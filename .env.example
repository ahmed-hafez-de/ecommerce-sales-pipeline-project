# Target PostgreSQL Database Configuration
PGHOST=127.0.0.1
PGPORT=54876
PGUSER=your_db_username
PGPASSWORD=your_db_password
PGDATABASE=ecommerce_platform

# App System Level Variables
ENVIRONMENT=development
LOG_LEVEL=INFO
